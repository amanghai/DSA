{%- liquid
  assign instagram_url = section.settings.social_instagram
  assign facebook_url  = section.settings.social_facebook
  assign youtube_url   = section.settings.social_youtube
  assign twitter_url   = section.settings.social_twitter
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">

<div class="nzk-progress-bar" id="nzkProgressBar"></div>
<div class="nzk-cursor-glow"   id="nzkCursorGlow"></div>

<div id="nzk-contact">
<style>
#nzk-contact *, #nzk-contact *::before, #nzk-contact *::after { box-sizing:border-box; margin:0; padding:0; }
:root {
  --nzk-white:     #FFFFFF;
  --nzk-navy:      #0A0F1E;
  --nzk-navy-deep: #06091A;
  --nzk-red:       #DC2626;
  --nzk-red-dark:  #B91C1C;
  --nzk-text:      #111827;
  --nzk-text-mid:  #374151;
  --nzk-text-lt:   #6B7280;
  --nzk-border:    #E5E7EB;
  --nzk-bg:        #F8F8F8;
}

/* PROGRESS BAR */
.nzk-progress-bar {
  position:fixed; top:0; left:0; height:3px; width:0%;
  background:linear-gradient(90deg,var(--nzk-navy),var(--nzk-red),#FF7070);
  z-index:9999; box-shadow:0 0 8px rgba(220,38,38,.45);
  transition:width .07s linear; pointer-events:none;
}
/* CURSOR GLOW */
.nzk-cursor-glow {
  position:fixed; width:360px; height:360px; border-radius:50%;
  pointer-events:none; z-index:1;
  background:radial-gradient(circle,rgba(220,38,38,.065) 0%,transparent 65%);
  transform:translate(-50%,-50%);
  will-change:left,top; mix-blend-mode:multiply;
}

/* BODY GRADIENT — breathes */
#nzk-contact {
  font-family:'Inter',sans-serif; color:var(--nzk-text); overflow-x:hidden;
  background:linear-gradient(135deg,#F9F9FB 0%,#F6F4FF 40%,#FFF4F6 70%,#F9F9FB 100%);
  background-size:400% 400%; animation:nzkBodyGrad 22s ease infinite;
}
@keyframes nzkBodyGrad {
  0%,100%{background-position:0% 50%;}
  33%    {background-position:100% 50%;}
  66%    {background-position:50% 0%;}
}

/* HERO */
.nzk-hero {
  position:relative; overflow:hidden; height:280px;
  background:linear-gradient(135deg,#FFFFFF 0%,#FFF8F8 25%,#FFFAFA 50%,#F8F8FF 75%,#FFFFFF 100%);
  background-size:400% 400%; animation:nzkHeroGrad 14s ease infinite;
  display:flex; align-items:center; border-bottom:1px solid var(--nzk-border);
}
@keyframes nzkHeroGrad {
  0%,100%{background-position:0% 50%;}
  50%    {background-position:100% 50%;}
}
.nzk-hero::before {
  content:''; position:absolute; inset:0;
  background-image:radial-gradient(circle,rgba(0,0,0,.055) 1px,transparent 1px);
  background-size:28px 28px; animation:nzkGridDrift 20s linear infinite;
}
@keyframes nzkGridDrift { from{background-position:0 0;} to{background-position:28px 28px;} }

.nzk-hero-slash { position:absolute; right:0; top:0; bottom:0; width:55%; overflow:hidden; pointer-events:none; }
.nzk-hero-slash::before {
  content:''; position:absolute; top:-20%; right:12%; width:5px; height:160%;
  background:var(--nzk-red); transform:rotate(-8deg); transform-origin:top center;
  animation:nzkSlashIn 1s cubic-bezier(.16,1,.3,1) both;
}
.nzk-hero-slash::after {
  content:''; position:absolute; top:-20%; right:16.5%; width:2px; height:160%;
  background:rgba(220,38,38,.22); transform:rotate(-8deg); transform-origin:top center;
  animation:nzkSlashIn 1s .1s cubic-bezier(.16,1,.3,1) both;
}
@keyframes nzkSlashIn { from{transform:rotate(-8deg) scaleY(0);opacity:0;} to{transform:rotate(-8deg) scaleY(1);opacity:1;} }

.nzk-hero-sweep {
  position:absolute; inset:0; pointer-events:none;
  background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.55) 50%,transparent 60%);
  background-size:300% 100%; animation:nzkSweep 5s 1.2s ease-in-out both;
}
@keyframes nzkSweep { from{background-position:130% 0;} to{background-position:-30% 0;} }

.nzk-hero-deco {
  position:absolute; right:68px; top:0; bottom:0;
  display:flex; flex-direction:column; justify-content:center; gap:14px;
  pointer-events:none; animation:nzkDecoIn .8s .5s ease both;
}
@keyframes nzkDecoIn { from{opacity:0;transform:translateX(16px);} to{opacity:1;transform:translateX(0);} }
.nzk-hdl { height:1px; background:var(--nzk-border); }
.nzk-hdl:nth-child(1){width:130px;} .nzk-hdl:nth-child(2){width:80px;}
.nzk-hdl:nth-child(3){width:155px;} .nzk-hdl:nth-child(4){width:60px;}

.nzk-hero-content { position:relative; z-index:2; padding:0 60px; max-width:720px; will-change:transform; }
.nzk-hero-eyebrow {
  font-size:10.5px; font-weight:700; letter-spacing:4px;
  color:var(--nzk-red); text-transform:uppercase; margin-bottom:14px;
  animation:nzkFadeUp .6s ease both;
}
.nzk-hero-title {
  font-size:clamp(32px,5.5vw,70px); font-weight:900; color:var(--nzk-text);
  line-height:1; letter-spacing:-2.5px; animation:nzkFadeUp .6s .1s ease both;
}
.nzk-hero-sub {
  display:block; font-size:clamp(13px,1.8vw,18px); font-weight:400;
  letter-spacing:.3px; color:var(--nzk-text-lt); margin-top:12px;
  animation:nzkFadeUp .6s .22s ease both;
}
.nzk-hero-redline {
  width:48px; height:3px; background:var(--nzk-red); margin-top:22px; border-radius:2px;
  animation:nzkLineGrow .8s .4s cubic-bezier(.16,1,.3,1) both;
}
@keyframes nzkFadeUp   { from{opacity:0;transform:translateY(14px);} to{opacity:1;transform:translateY(0);} }
@keyframes nzkLineGrow { from{width:0;opacity:0;} to{width:48px;opacity:1;} }

/* PAGE WRAP */
.nzk-page-wrap { position:relative; overflow:hidden; }

/* ORBS */
.nzk-orb { position:absolute; border-radius:50%; pointer-events:none; z-index:0; will-change:transform; }
.nzk-orb-1 {
  width:560px; height:560px; top:-80px; left:-130px;
  background:radial-gradient(circle,rgba(220,38,38,.055) 0%,rgba(220,38,38,.015) 45%,transparent 70%);
  animation:nzkOrbDrift 28s ease-in-out infinite;
}
.nzk-orb-2 {
  width:440px; height:440px; top:180px; right:-100px;
  background:radial-gradient(circle,rgba(99,102,241,.05) 0%,rgba(99,102,241,.01) 45%,transparent 70%);
  animation:nzkOrbDrift 34s 6s ease-in-out infinite reverse;
}
.nzk-orb-3 {
  width:320px; height:320px; bottom:80px; left:18%;
  background:radial-gradient(circle,rgba(220,38,38,.04) 0%,transparent 70%);
  animation:nzkOrbDrift 22s 12s ease-in-out infinite;
}
@keyframes nzkOrbDrift {
  0%,100%{transform:translate(0,0) scale(1);}
  33%    {transform:translate(28px,-22px) scale(1.06);}
  66%    {transform:translate(-18px,18px) scale(.95);}
}
.nzk-bg-shape { position:absolute; border-radius:2px; border:1px solid rgba(0,0,0,.04); pointer-events:none; z-index:0; will-change:transform; }
.nzk-bgs1{width:60px;height:60px;top:80px;left:3%;}
.nzk-bgs2{width:36px;height:36px;top:300px;right:4%;border-radius:50%;}
.nzk-bgs3{width:48px;height:48px;bottom:120px;left:6%;}
.nzk-bgs4{width:24px;height:24px;top:50px;right:12%;border-radius:50%;}

/* CONTACT SECTION */
.nzk-contact-section { max-width:1280px; margin:0 auto; padding:72px 40px 100px; position:relative; z-index:1; }
.nzk-card-scene { perspective:1100px; perspective-origin:50% 38%; }
.nzk-card {
  display:grid; grid-template-columns:360px 1fr;
  border-radius:4px; overflow:hidden; border:1px solid var(--nzk-border);
  will-change:transform; animation:nzkCardReveal .9s cubic-bezier(.22,1,.36,1) both;
  box-shadow:0 2px 4px rgba(0,0,0,.04),0 8px 24px rgba(0,0,0,.06),0 32px 64px rgba(0,0,0,.06);
  position:relative;
}
@keyframes nzkCardReveal {
  from{opacity:0;transform:perspective(1100px) rotateX(10deg) translateY(50px) scale(.96);}
  to  {opacity:1;transform:perspective(1100px) rotateX(0) translateY(0) scale(1);}
}
.nzk-card-edge { position:absolute; inset:-1px; border-radius:4px; pointer-events:none; z-index:20; border:1px solid transparent; }
.nzk-card-shadow {
  height:50px; margin:0 60px;
  background:radial-gradient(ellipse at 50% 0%,rgba(0,0,0,.2) 0%,transparent 70%);
  animation:nzkShadowPulse 4s ease-in-out infinite; filter:blur(4px);
}
@keyframes nzkShadowPulse { 0%,100%{transform:scaleX(1);opacity:.8;} 50%{transform:scaleX(.88);opacity:.35;} }

/* LEFT PANEL */
.nzk-panel-left {
  background:linear-gradient(155deg,#0D1328 0%,#0A0F1E 40%,#130825 70%,#080C18 100%);
  background-size:200% 200%; animation:nzkPanelGrad 16s ease infinite;
  padding:52px 40px; position:relative; overflow:hidden; display:flex; flex-direction:column;
}
@keyframes nzkPanelGrad {
  0%,100%{background-position:0% 0%;}
  50%    {background-position:100% 100%;}
}
.nzk-panel-left::before {
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:linear-gradient(90deg,transparent,var(--nzk-red),#FF6B6B,var(--nzk-red),transparent);
  background-size:300% 100%; animation:nzkRedSweep 3s linear infinite;
}
@keyframes nzkRedSweep { 0%{background-position:100% 0;} 100%{background-position:-100% 0;} }
.nzk-panel-left::after {
  content:'NT'; position:absolute; bottom:-30px; right:-20px;
  font-size:180px; font-weight:900; color:rgba(255,255,255,.03);
  letter-spacing:-10px; user-select:none; pointer-events:none; line-height:1;
  animation:nzkWatermarkDrift 18s ease-in-out infinite;
}
@keyframes nzkWatermarkDrift { 0%,100%{transform:translate(0,0) rotate(0deg);} 50%{transform:translate(-10px,-12px) rotate(-2deg);} }

.nzk-panel-glow {
  position:absolute; top:-100px; right:-100px; width:320px; height:320px; border-radius:50%;
  background:radial-gradient(circle,rgba(220,38,38,.24) 0%,rgba(220,38,38,.06) 50%,transparent 70%);
  pointer-events:none; animation:nzkGlowPulse 4.5s ease-in-out infinite;
}
@keyframes nzkGlowPulse { 0%,100%{opacity:.6;transform:scale(1);} 50%{opacity:1;transform:scale(1.2);} }
.nzk-panel-glow2 {
  position:absolute; bottom:-60px; left:-40px; width:220px; height:220px; border-radius:50%;
  background:radial-gradient(circle,rgba(220,38,38,.1) 0%,transparent 70%);
  pointer-events:none; animation:nzkGlowPulse 6s 2.5s ease-in-out infinite;
}

.nzk-particles { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.nzk-p { position:absolute; border-radius:50%; animation:nzkParticleRise linear infinite; }
.nzk-p1{width:3px;height:3px;left:18%;background:rgba(220,38,38,.6);animation-duration:9s;animation-delay:0s;}
.nzk-p2{width:2px;height:2px;left:55%;background:rgba(220,38,38,.4);animation-duration:13s;animation-delay:-4s;}
.nzk-p3{width:4px;height:4px;left:78%;background:rgba(220,38,38,.5);animation-duration:10s;animation-delay:-7s;}
.nzk-p4{width:2px;height:2px;left:38%;background:rgba(255,255,255,.25);animation-duration:16s;animation-delay:-2s;}
.nzk-p5{width:3px;height:3px;left:67%;background:rgba(255,255,255,.18);animation-duration:12s;animation-delay:-9s;}
.nzk-p6{width:2px;height:2px;left:85%;background:rgba(220,38,38,.35);animation-duration:8s;animation-delay:-5s;}
@keyframes nzkParticleRise {
  0%  {bottom:-8px;opacity:0;transform:translateX(0) scale(1);}
  15% {opacity:1;}
  85% {opacity:.8;}
  100%{bottom:105%;opacity:0;transform:translateX(18px) scale(0);}
}

.nzk-store-badge {
  display:inline-flex; align-items:center; gap:8px;
  background:rgba(220,38,38,.14); border:1px solid rgba(220,38,38,.35);
  border-radius:2px; padding:6px 14px 6px 10px; margin-bottom:28px; width:fit-content;
  animation:nzkFadeUp .5s .6s ease both; position:relative; z-index:2;
  box-shadow:0 6px 20px rgba(220,38,38,.2);
  transition:background .25s, box-shadow .25s, transform .35s cubic-bezier(.34,1.56,.64,1);
}
.nzk-store-badge:hover { background:rgba(220,38,38,.24); box-shadow:0 10px 28px rgba(220,38,38,.38); transform:translateY(-3px); }
.nzk-badge-dot { width:6px; height:6px; border-radius:50%; background:var(--nzk-red); animation:nzkDotPulse 2s ease-in-out infinite; }
@keyframes nzkDotPulse { 0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,.55);} 50%{box-shadow:0 0 0 7px rgba(220,38,38,0);} }
.nzk-badge-text { font-size:9px; font-weight:700; letter-spacing:2px; color:rgba(230,80,80,1); text-transform:uppercase; }

.nzk-panel-heading {
  font-family:'Libre Baskerville',serif; font-size:28px; font-weight:700;
  line-height:1.28; margin-bottom:12px; letter-spacing:-.3px;
  background:linear-gradient(90deg,#FFFFFF 0%,#FFE0E0 20%,#FF8080 45%,#FF5050 50%,#FF8080 55%,#FFE0E0 80%,#FFFFFF 100%);
  background-size:300% 100%;
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
  animation:nzkFadeUp .5s .7s ease both, nzkHeadingGrad 5s 1.5s ease infinite;
  position:relative; z-index:2;
}
@keyframes nzkHeadingGrad {
  0%,100%{background-position:0% 50%;}
  50%    {background-position:100% 50%;}
}
.nzk-panel-sub { font-size:13.5px; color:rgba(255,255,255,.72); line-height:1.78; margin-bottom:36px; animation:nzkFadeUp .5s .8s ease both; position:relative; z-index:2; }

.nzk-contact-list { display:flex; flex-direction:column; margin-bottom:36px; position:relative; z-index:2; }
.nzk-contact-item {
  display:flex; align-items:flex-start; gap:14px;
  padding:15px 0 15px 10px;
  border-bottom:1px solid rgba(255,255,255,.1);
  border-left:2px solid transparent;
  transition:border-left-color .25s, padding-left .25s, background .25s;
  cursor:default; animation:nzkFadeUp .5s ease both;
  text-decoration:none; color:inherit;
}
.nzk-contact-item:first-child { border-top:1px solid rgba(255,255,255,.1); }
.nzk-contact-item:nth-child(1){animation-delay:.85s;}
.nzk-contact-item:nth-child(2){animation-delay:.95s;}
.nzk-contact-item:nth-child(3){animation-delay:1.05s;}
.nzk-contact-item:hover { border-left-color:var(--nzk-red); padding-left:16px; background:rgba(220,38,38,.06); }

.nzk-contact-icon {
  width:36px; height:36px; border-radius:2px; background:var(--nzk-red); flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  box-shadow:0 4px 14px rgba(220,38,38,.35);
  transition:transform .38s cubic-bezier(.34,1.56,.64,1), box-shadow .25s;
}
.nzk-contact-item:hover .nzk-contact-icon { transform:scale(1.14) rotate(12deg); box-shadow:0 8px 22px rgba(220,38,38,.58); }
.nzk-contact-icon svg { width:15px; height:15px; stroke:#fff; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
.nzk-contact-label { font-size:9px; font-weight:700; letter-spacing:2px; color:rgba(240,100,100,1); text-transform:uppercase; margin-bottom:4px; }
.nzk-contact-value { font-size:13px; color:rgba(255,255,255,.92); font-weight:400; line-height:1.58; }

.nzk-social-row { display:flex; gap:8px; flex-wrap:wrap; margin-top:auto; position:relative; z-index:2; }
.nzk-social-btn {
  width:38px; height:38px; border-radius:2px;
  background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18);
  display:flex; align-items:center; justify-content:center;
  cursor:pointer; transition:all .38s cubic-bezier(.34,1.56,.64,1); animation:nzkFadeUp .4s ease both;
  text-decoration:none;
}
.nzk-social-btn:nth-child(1){animation-delay:1.1s;} .nzk-social-btn:nth-child(2){animation-delay:1.18s;}
.nzk-social-btn:nth-child(3){animation-delay:1.26s;} .nzk-social-btn:nth-child(4){animation-delay:1.34s;}
.nzk-social-btn svg { width:15px; height:15px; stroke:rgba(255,255,255,.65); fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; transition:stroke .2s; }
.nzk-social-btn:hover { background:rgba(220,38,38,.2); border-color:rgba(220,38,38,.5); transform:translateY(-5px) scale(1.14); box-shadow:0 8px 22px rgba(220,38,38,.38); }
.nzk-social-btn:hover svg { stroke:rgba(255,120,120,1); }

/* RIGHT PANEL */
.nzk-panel-right { background:var(--nzk-white); padding:52px 56px; position:relative; overflow:hidden; }
.nzk-panel-right::before {
  content:''; position:absolute; top:0; right:0; width:0; height:0;
  border-style:solid; border-width:0 44px 44px 0;
  border-color:transparent rgba(220,38,38,.07) transparent transparent;
}
.nzk-panel-right::after {
  content:''; position:absolute; top:0; left:-120%; width:60%; height:100%;
  background:linear-gradient(90deg,transparent,rgba(220,38,38,.03),transparent);
  animation:nzkPanelShimmer 8s 2s ease-in-out infinite; pointer-events:none;
}
@keyframes nzkPanelShimmer { 0%{left:-120%;} 100%{left:160%;} }

.nzk-form-label-top { font-size:10px; font-weight:700; letter-spacing:3px; color:var(--nzk-red); text-transform:uppercase; margin-bottom:10px; animation:nzkFadeUp .5s .7s ease both; }
.nzk-form-title { font-size:clamp(22px,2.8vw,32px); font-weight:800; color:var(--nzk-text); letter-spacing:-1px; line-height:1.1; animation:nzkFadeUp .5s .8s ease both; }
.nzk-form-redline {
  width:36px; height:2px; background:var(--nzk-red); margin:16px 0 36px; border-radius:1px;
  animation:nzkLineGrow2 .8s .95s cubic-bezier(.16,1,.3,1) both;
}
@keyframes nzkLineGrow2 { from{width:0;opacity:0;} to{width:36px;opacity:1;} }

/* SUCCESS / ERROR messages */
.nzk-form-success {
  background:rgba(34,197,94,.08); border:1px solid rgba(34,197,94,.35); border-radius:4px;
  padding:18px 24px; margin-bottom:28px;
  font-size:14px; color:#166534; font-weight:500; line-height:1.6;
}
.nzk-form-error {
  background:rgba(220,38,38,.07); border:1px solid rgba(220,38,38,.3); border-radius:4px;
  padding:16px 22px; margin-bottom:24px;
  font-size:13px; color:var(--nzk-red); font-weight:500; line-height:1.6;
}
.nzk-form-error ul { padding-left:18px; margin-top:6px; }
.nzk-form-error ul li { margin-bottom:4px; }

.nzk-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px 24px; }
.nzk-fg { display:flex; flex-direction:column; }
.nzk-fg.nzk-full { grid-column:1/-1; }

.nzk-fg label {
  font-size:10px; font-weight:700; letter-spacing:1.5px; color:var(--nzk-text-lt);
  text-transform:uppercase; margin-bottom:8px;
  transition:color .25s, letter-spacing .28s; display:block;
}
.nzk-fg:focus-within label { color:var(--nzk-red); letter-spacing:2.5px; }

.nzk-fg.nzk-one{animation:nzkFadeUp .4s 1.0s ease both;} .nzk-fg.nzk-two{animation:nzkFadeUp .4s 1.1s ease both;}
.nzk-fg.nzk-thr{animation:nzkFadeUp .4s 1.2s ease both;} .nzk-fg.nzk-fou{animation:nzkFadeUp .4s 1.3s ease both;}

.nzk-field-wrap { position:relative; transition:transform .28s cubic-bezier(.34,1.56,.64,1); }
.nzk-fg:focus-within .nzk-field-wrap { transform:translateY(-2px); }

.nzk-fg input, .nzk-fg textarea {
  background:transparent; border:none; border-bottom:1.5px solid var(--nzk-border);
  padding:10px 2px; color:var(--nzk-text); font-family:'Inter',sans-serif;
  font-size:14px; outline:none; resize:none; width:100%; transition:border-color .22s;
}
.nzk-fg textarea { height:90px; padding-top:8px; }
.nzk-field-line {
  position:absolute; bottom:0; left:0; width:0; height:2px;
  background:var(--nzk-red); border-radius:1px; transition:width .3s cubic-bezier(.16,1,.3,1);
}
.nzk-fg input:focus ~ .nzk-field-line, .nzk-fg textarea:focus ~ .nzk-field-line { width:100%; }
.nzk-fg input::placeholder, .nzk-fg textarea::placeholder { color:#BFC7D0; font-size:13px; }

.nzk-submit-btn {
  margin-top:40px; padding:15px 48px;
  background:var(--nzk-navy); border:none; border-radius:2px;
  color:#fff; font-family:'Inter',sans-serif;
  font-size:11.5px; font-weight:700; letter-spacing:2.5px; text-transform:uppercase;
  cursor:pointer; position:relative; overflow:hidden;
  transition:transform .28s cubic-bezier(.16,1,.3,1), box-shadow .28s;
  box-shadow:0 4px 0 var(--nzk-navy-deep),0 8px 24px rgba(10,15,30,.2);
  animation:nzkFadeUp .4s 1.4s ease both;
  display:inline-flex; align-items:center; gap:10px;
}
.nzk-submit-btn::before {
  content:''; position:absolute; top:0; left:-100%; width:50%; height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.13),transparent);
  transition:left .5s ease;
}
.nzk-submit-btn::after {
  content:''; position:absolute; top:0; left:0; right:0; height:2px;
  background:var(--nzk-red); transform:scaleX(0); transform-origin:left;
  transition:transform .3s cubic-bezier(.16,1,.3,1);
}
.nzk-submit-btn:hover { transform:translateY(-5px); box-shadow:0 10px 0 var(--nzk-navy-deep),0 20px 40px rgba(10,15,30,.28); }
.nzk-submit-btn:hover::before { left:140%; }
.nzk-submit-btn:hover::after  { transform:scaleX(1); }
.nzk-submit-btn:active { transform:translateY(2px); box-shadow:0 2px 0 var(--nzk-navy-deep),0 4px 10px rgba(10,15,30,.18); }
.nzk-btn-arrow { transition:transform .25s; display:inline-block; }
.nzk-submit-btn:hover .nzk-btn-arrow { transform:translateX(5px); }
.nzk-ripple {
  position:absolute; border-radius:50%; background:rgba(255,255,255,.22);
  width:10px; height:10px; margin:-5px 0 0 -5px;
  transform:scale(0); animation:nzkRipple .55s linear; pointer-events:none;
}
@keyframes nzkRipple { to { transform:scale(30); opacity:0; } }

/* SCROLL REVEAL */
.nzk-reveal       { opacity:0; transform:translateY(36px); }
.nzk-reveal-left  { opacity:0; transform:translateX(-36px); }
.nzk-reveal-right { opacity:0; transform:translateX(36px); }
.nzk-reveal-scale { opacity:0; transform:scale(.93); }
.nzk-reveal.in,.nzk-reveal-left.in,.nzk-reveal-right.in,.nzk-reveal-scale.in {
  opacity:1; transform:none;
  transition:opacity .78s ease, transform .78s cubic-bezier(.16,1,.3,1);
}
.nzk-d1{transition-delay:.08s!important;} .nzk-d2{transition-delay:.18s!important;}
.nzk-d3{transition-delay:.28s!important;} .nzk-d4{transition-delay:.38s!important;}

/* RESPONSIVE */
@media (max-width:900px) {
  .nzk-card { grid-template-columns:1fr; }
  .nzk-panel-left { padding:40px 24px; }
  .nzk-panel-right { padding:40px 24px; }
  .nzk-form-grid { grid-template-columns:1fr; gap:24px; }
  .nzk-hero-content { padding:0 24px; }
  .nzk-hero-slash { width:30%; }
  .nzk-hero-deco { right:36px; }
  .nzk-card-shadow { display:none; }
  .nzk-contact-section { padding:40px 16px 72px; }
  .nzk-bgs1{width:36px;height:36px;} .nzk-bgs3{width:28px;height:28px;}
  .nzk-bgs2,.nzk-bgs4{display:none;}
  .nzk-orb-1,.nzk-orb-2,.nzk-orb-3 { display:none; }
  .nzk-cursor-glow { display:none; }
}
@media (max-width:480px) {
  .nzk-hero-content { padding:0 16px; }
  .nzk-hero-deco { display:none; }
}
</style>

