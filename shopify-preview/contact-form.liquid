<script>
(function () {
  /* SCROLL PROGRESS BAR */
  var nzkPB = document.getElementById('nzkProgressBar');
  if (nzkPB) {
    function nzkUpdateProgress() {
      var max = document.documentElement.scrollHeight - window.innerHeight;
      nzkPB.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
    }
    window.addEventListener('scroll', nzkUpdateProgress, { passive: true });
  }

  /* CURSOR GLOW */
  var nzkCG = document.getElementById('nzkCursorGlow');
  if (nzkCG) {
    document.addEventListener('mousemove', function (e) {
      nzkCG.style.left = e.clientX + 'px';
      nzkCG.style.top  = e.clientY + 'px';
    });
  }

  /* SCROLL REVEAL */
  (function () {
    var els = document.querySelectorAll('.nzk-reveal,.nzk-reveal-left,.nzk-reveal-right,.nzk-reveal-scale');
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
      });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();

  /* SCROLL PARALLAX */
  (function () {
    var hc   = document.getElementById('nzkHeroContent');
    var o1   = document.getElementById('nzkOrb1');
    var o2   = document.getElementById('nzkOrb2');
    var o3   = document.getElementById('nzkOrb3');
    var bgs  = [
      { el: document.getElementById('nzkBgs1'), speed: 0.18, rot: 15 },
      { el: document.getElementById('nzkBgs2'), speed: 0.28, rot: 45 },
      { el: document.getElementById('nzkBgs3'), speed: 0.22, rot: -10 },
      { el: document.getElementById('nzkBgs4'), speed: 0.14, rot: 30 }
    ];
    window.addEventListener('scroll', function () {
      var sy = window.scrollY;
      if (hc) hc.style.transform = 'translateY(' + (sy * 0.35) + 'px)';
      if (o1) o1.style.transform = 'translate(0,' + (sy * 0.12) + 'px)';
      if (o2) o2.style.transform = 'translate(0,' + (-sy * 0.08) + 'px)';
      if (o3) o3.style.transform = 'translate(0,' + (sy * 0.06) + 'px)';
      bgs.forEach(function (b) {
        if (b.el) {
          var d = sy * b.speed;
          b.el.style.transform = 'translateY(' + d + 'px) rotate(' + (b.rot + d * 0.08) + 'deg)';
          b.el.style.opacity   = Math.max(0.2, 0.7 - d * 0.002);
        }
      });
    }, { passive: true });
  })();

  /* RIPPLE on submit */
  var nzkSB = document.getElementById('nzkSubmitBtn');
  if (nzkSB) {
    nzkSB.addEventListener('click', function (e) {
      var rect = nzkSB.getBoundingClientRect();
      var rip  = document.createElement('span');
      rip.className = 'nzk-ripple';
      rip.style.left = (e.clientX - rect.left) + 'px';
      rip.style.top  = (e.clientY - rect.top)  + 'px';
      nzkSB.appendChild(rip);
      setTimeout(function () { rip.remove(); }, 600);
    });
  }

  /* 3D TILT + PARALLAX */
  (function () {
    var card     = document.getElementById('nzkTiltCard');
    var cardEdge = document.getElementById('nzkCardEdge');
    if (!card) return;
    var layers   = card.querySelectorAll('[data-depth]');
    var cX = 0, cY = 0, tX = 0, tY = 0, hovering = false, time = 0;
    var isMobile = window.matchMedia('(max-width:900px)').matches;
    var MAX = isMobile ? 10 : 20;

    function lerp(a, b, f) { return a + (b - a) * f; }
    function setTarget(clientX, clientY) {
      var r  = card.getBoundingClientRect();
      var dx = (clientX - (r.left + r.width  / 2)) / (r.width  / 2);
      var dy = (clientY - (r.top  + r.height / 2)) / (r.height / 2);
      tX =  dx * MAX;
      tY = -dy * (MAX * 0.7);
    }

    card.addEventListener('mouseenter', function () { hovering = true; });
    card.addEventListener('mouseleave', function () { hovering = false; });
    card.addEventListener('mousemove',  function (e) { setTarget(e.clientX, e.clientY); });
    card.addEventListener('touchstart', function ()  { hovering = true; },  { passive: true });
    card.addEventListener('touchend',   function ()  { hovering = false; }, { passive: true });
    card.addEventListener('touchmove',  function (e) { setTarget(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });

    (function tick() {
      time += 0.012;
      if (hovering) {
        cX = lerp(cX, tX, 0.09);
        cY = lerp(cY, tY, 0.09);
      } else {
        cX = lerp(cX, Math.sin(time * 0.65) * 2.8, 0.04);
        cY = lerp(cY, Math.cos(time * 0.45) * 2.0, 0.04);
      }
      var d = Math.sqrt(cX * cX + cY * cY);
      card.style.transform =
        'perspective(1100px) rotateY(' + cX + 'deg) rotateX(' + cY + 'deg)';
      card.style.boxShadow =
        '0 ' + (2  + d * 0.6) + 'px ' + (8  + d * 0.8) + 'px rgba(0,0,0,.06),' +
        '0 ' + (8  + d * 1.2) + 'px ' + (28 + d * 2.5) + 'px rgba(0,0,0,' + (.07 + d * .006) + '),' +
        '0 ' + (28 + d * 2.5) + 'px ' + (64 + d * 4)   + 'px rgba(0,0,0,' + (.05 + d * .004) + ')';
      var gA = Math.min(d / MAX, 1) * 0.6;
      var gR = cX > 0 ? Math.min(cX / MAX, 1) : 0;
      var gL = cX < 0 ? Math.min(-cX / MAX, 1) : 0;
      cardEdge.style.boxShadow =
        'inset '  + (gR * 12) + 'px 0 24px rgba(220,38,38,' + (gA * gR) + '),' +
        'inset -' + (gL * 12) + 'px 0 24px rgba(220,38,38,' + (gA * gL) + ')';
      if (!isMobile) {
        layers.forEach(function (el) {
          var depth = parseFloat(el.getAttribute('data-depth'));
          el.style.transform = 'translate(' + (cX * depth * 0.9) + 'px,' + (-cY * depth * 0.6) + 'px)';
        });
      }
      requestAnimationFrame(tick);
    })();
  })();
})();
</script>

